# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.venv/

# Model assets & data (download / generate locally)
pretrained_models/
checkpoints/
data/
output/
outputs/
log/
logs/
runs/

# Audio artifacts
*.wav
*.flac
*.mp3
*.ogg

# Project-page demos are intentionally versioned.
!assets/audio/**/*.wav
!assets/audio/**/*.flac
!assets/audio/**/*.mp3
!assets/audio/**/*.ogg

# Prompt audio used by the reproducible single-inference examples.
!examples/prompt_audio/*.wav

# Reference voices for the web demo (Git LFS, see demo/.gitattributes).
!demo/assets/*.wav

# Web demo scratch
.venv-demo/
demo/.venv-gpu/
demo/tests/browser/shots/

# Editor / OS
.idea/
.vscode/
.DS_Store
